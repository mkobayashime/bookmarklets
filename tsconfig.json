{
	"include": ["**/*.ts", "**/*.js"],
	"compilerOptions": {
		"target": "es2020",
		"module": "ESNext",
		"lib": ["DOM", "ESNext"],
		"moduleResolution": "bundler",
		"noEmit": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true
	}
}
